{
  "name": "gta4-webmap",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "npx --yes http-server web -p 4174 -c-1",
    "extract": "powershell -NoProfile -ExecutionPolicy Bypass -File ./extract-map.ps1",
    "extract:world": "powershell -NoProfile -ExecutionPolicy Bypass -File ./extract-world.ps1",
    "extract:timecyc": "node ./tools/parse-timecyc.mjs",
    "extract:sky": "node -e \"require('child_process').execFileSync(require('fs').existsSync('.dotnet/dotnet.exe')?'.dotnet/dotnet.exe':'dotnet',['extractor/bin/Release/net8.0/Gta4MapExtractor.dll','--dump-txd','..','pc/textures/skydome.wtd','web/assets/sky'],{stdio:'inherit'})\"",
    "extract:paths": "node ./tools/parse-paths.mjs",
    "extract:navmesh": "node -e \"require('child_process').execFileSync(require('fs').existsSync('.dotnet/dotnet.exe')?'.dotnet/dotnet.exe':'dotnet',['extractor/bin/Release/net8.0/Gta4MapExtractor.dll','--extract-navmesh','..','web/data/navmesh.json','2.5'],{stdio:'inherit'})\"",
    "extract:player": "powershell -NoProfile -ExecutionPolicy Bypass -File ./extract-player.ps1",
    "extract:vehicles": "powershell -NoProfile -ExecutionPolicy Bypass -File ./extract-vehicles.ps1",
    "extract:peds": "powershell -NoProfile -ExecutionPolicy Bypass -File ./extract-peds.ps1",
    "extract:weapons": "node -e \"require('child_process').execFileSync(require('fs').existsSync('.dotnet/dotnet.exe')?'.dotnet/dotnet.exe':'dotnet',['extractor/bin/Release/net8.0/Gta4MapExtractor.dll','--extract-weapons','..','web/assets/weapons','web/assets/weapons/textures','textures/'],{stdio:'inherit'})\"",
    "pack": "node ./tools/pack-textures.mjs",
    "test": "node ./test/smoke.mjs",
    "test:player": "node ./test/player.mjs",
    "test:vehicles": "node ./test/vehicles.mjs",
    "test:peds": "node ./test/peds.mjs",
    "test:traffic": "node ./test/traffic.mjs",
    "test:world-traffic": "node ./test/world-traffic.mjs",
    "test:crowd": "node ./test/crowd.mjs",
    "test:wanted": "node ./test/wanted.mjs",
    "test:driving": "node ./test/driving.mjs",
    "test:weapons": "node ./test/weapons.mjs",
    "test:walk": "node ./test/walk.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "http-server": "14.1.1",
    "playwright-core": "1.62.1"
  }
}
