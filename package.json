{
  "name": "gta4-webmap",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "npx --yes http-server web -p 4174 -c-1",
    "extract": "powershell -NoProfile -ExecutionPolicy Bypass -File ./extract-map.ps1",
    "extract:world": "powershell -NoProfile -ExecutionPolicy Bypass -File ./extract-world.ps1",
    "extract:timecyc": "node ./tools/parse-timecyc.mjs",
    "extract:player": "powershell -NoProfile -ExecutionPolicy Bypass -File ./extract-player.ps1",
    "pack": "node ./tools/pack-textures.mjs",
    "test": "node ./test/smoke.mjs",
    "test:player": "node ./test/player.mjs",
    "test:walk": "node ./test/walk.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "http-server": "14.1.1",
    "playwright-core": "1.62.1"
  }
}
