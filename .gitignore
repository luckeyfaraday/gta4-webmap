# Extracted Rockstar assets. ~2 GB of geometry and textures rebuilt by
# `npm run extract:world`; never belongs in the repository.
web/assets/

# Build and tooling output
node_modules/
extractor/bin/
extractor/obj/
.dotnet/
artifacts/
.claude/worktrees/
*.log
coverage/

# Local configuration and editor/OS metadata
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db
*.suo
*.user

# Vendored IV-Unity converter: an upstream checkout with its own git history.
# RageLib under converter/Assets/Scripts is compiled into the extractor by
# path, so worktrees junction this directory rather than copying it.
converter/

# Derived from the installed game by the extract:* scripts — the timecycle, the
# road graph and the ped navmesh. Rockstar data, so it stays local like
# web/assets.
web/data/

# Downloaded on demand by install-dotnet.ps1.
dotnet-install.ps1
